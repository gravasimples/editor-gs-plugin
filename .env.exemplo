# Editor GS — chaves opcionais. Copie para `.env` (dentro de ~/EditorGS quando instalado como plugin) e preencha só o que for usar.
# Nada aqui é obrigatório: edição, cortes, legenda, grafismos, carrossel, capa e voz sintética funcionam sem chave nenhuma.
# Nunca commite o `.env`. Segredos ficam só nesta máquina.

# --- Caminhos (o instalador preenche) ---
# EDITOR_GS_VENV=C:\Users\voce\.venvs\editor-gs
# EDITOR_GS_PORTA=3200

# --- Revisor de vídeo e tradução de legenda (Google AI Studio, gratuito) ---
GEMINI_API_KEY=

# --- Instagram pela API oficial da Meta (docs/META-APP.md) ---
# (a) Instagram Login: conta própria, mídias, insights, comentários, publicar
META_IG_TOKEN=
META_IG_USER_ID=
# (b) Facebook Login com Página: concorrentes e referências (business_discovery)
META_FB_TOKEN=
META_FB_IG_USER_ID=
# opcional, para renovar o token
META_APP_ID=
META_APP_SECRET=

# --- Agendamento multi-rede (Publora) ---
PUBLORA_API_KEY=

# --- YouTube: upload direto (OAuth do Google, docs/YOUTUBE-APP.md) e garimpo de referências (API key) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- Canva Connect (docs/CANVA-CONNECT.md) ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# --- Bancos de imagem gratuitos (b-roll de apoio; docs/MATERIAIS-GRATUITOS.md) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Google Drive via rclone (remoto configurado com `rclone config`; docs/MATERIAIS-DRIVE.md) ---
# DRIVE_MATERIAIS=gs:10. Mídias/Materiais
# DRIVE_DESTINO=gs:10. Mídias/Entregas do Editor
# DRIVE_PARA_EDITAR=gs:10. Mídias/Materiais para Editar
# DRIVE_ANEXOS=gsp2:

# --- Notion (botão "mandar para o cartão", campo "Roteiro do pulso") ---
NOTION_TOKEN=

# --- Acesso de fora (Tailscale Funnel; docs/ACESSO-EXTERNO.md): chaves separadas por vírgula, formato nome:chave ---
# EDITOR_GS_CHAVES=
# EDITOR_GS_URL_PUBLICA=

# --- Métricas, acervo e "o que rende" leem o banco do GSI (só na máquina da Grava Simples) ---
# EDITOR_GS_GSI=
