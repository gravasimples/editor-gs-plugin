# Fim de linha por tipo. Padrão LF em tudo (o Claude Code não lê frontmatter YAML com CRLF: comandos e skills do plugin
# chegavam com metadados vazios em checkout Windows com autocrlf). cmd.exe exige CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.wav binary
*.png binary
*.jpg binary
*.mp4 binary
*.task binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.ico binary
